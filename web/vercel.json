{
  "build": {
    "env": {
      "DEPLOY_CACHE_BUST": "backend-port-8001-v1",
      "BACKEND_REWRITE_URL": "http://164.90.235.14:8001"
    }
  },
  "headers": [
    {
      "source": "/activate-appsumo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Deploy-Cache-Bust",
          "value": "activate-appsumo-edge-bust-v5"
        }
      ]
    },
    {
      "source": "/activate-appsumo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Deploy-Cache-Bust",
          "value": "activate-appsumo-edge-bust-v5"
        }
      ]
    }
  ],
  "functions": {
    "app/api/run-analysis/route.ts": {
      "maxDuration": 15
    },
    "app/api/analysis-status/[taskId]/route.ts": {
      "maxDuration": 15
    },
    "app/api/activate-appsumo-code/route.ts": {
      "maxDuration": 30
    }
  }
}
